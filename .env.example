# MadhanKR CMS V2 — Environment Configuration
# Copy to .env.local and add your actual values there.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-key-placeholder

# Server-only secret; never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-server-secret-placeholder

# Random token for on-demand revalidation.
REVALIDATE_SECRET_TOKEN=your-random-token-placeholder

# Canonical website URL (optional: dynamically resolves Netlify's URL on deployment, defaults to http://localhost:3000 locally).
# NEXT_PUBLIC_SITE_URL=https://your-custom-domain.com