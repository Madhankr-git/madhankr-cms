# ══════════════════════════════════════════════════════════════════
# MADHANKR CMS & PORTFOLIO — GITIGNORE
# Prevents accidental commits of dependencies, secrets, IDE files,
# system metadata, and local database backup exports.
# ══════════════════════════════════════════════════════════════════

# Node dependencies & lockfiles
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment secrets and credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.cert
secrets/
credentials.json

# Local CMS data backup exports
madhankr-cms-backup-*.json

# IDE & workspace files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.agents/
.gemini/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Logs and temporary files
*.log
*.tmp
*.temp
scratch/

# Build and distribution output
dist/
build/
out/
